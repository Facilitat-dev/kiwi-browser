# Release APK. Chromium 153 desktop-android + privacy flags.
# Package ID is ours. Do not ship Google API keys or field trials.

target_os = "android"
target_cpu = "arm64"
is_desktop_android = true
is_debug = false
is_official_build = true
is_chrome_branded = false
is_component_build = false
chrome_pgo_phase = 0
use_v8_context_snapshot = false
symbol_level = 0
blink_symbol_level = 0
dcheck_always_on = false
treat_warnings_as_errors = false
disable_android_lint = true

chrome_public_manifest_package = "app.canopy.browser"

# No Google keys, no telemetry, no manufacturer integration.
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
disable_fieldtrial_testing_config = true
enable_reporting = false
enable_hangout_services_extension = false
enable_mdns = false
enable_remoting = false
enable_vr = false
enable_arcore = false
enable_openxr = false
build_contextual_search = false
enable_bound_session_credentials = false
enable_request_header_integrity = false
safe_browsing_use_unrar = false

# Media: play common web video without Widevine/Google DRM.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = false
enable_pdf = false
enable_plugins = false
