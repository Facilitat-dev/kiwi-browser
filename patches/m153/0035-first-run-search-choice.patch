+    /**
+     * Prepopulated engines only. Preferred keywords lead; everything else keeps its relative order.
+     */
+    private static List<TemplateUrl> canopyChoiceEngines(List<TemplateUrl> all) {
+        List<TemplateUrl> engines = new ArrayList<>();
+        for (TemplateUrl engine : all) {
+            if (engine.getPrepopulatedId() != 0) {
+                engines.add(engine);
+            }
+        }
+        List<TemplateUrl> ordered = new ArrayList<>();
+        for (String keyword : CANOPY_ENGINE_ORDER) {
+            for (int i = 0; i < engines.size(); i++) {
+                if (keyword.equals(engines.get(i).getKeyword())) {
+                    ordered.add(engines.remove(i));
+                    break;
+                }
+            }
+        }
+        ordered.addAll(engines);
+        return ordered;
+    }
