+// Canopy: DuckDuckGo leads every regional list, including countries whose
+// top-N omits it. Google is inserted when a list does not already contain it.
+void EnsureCanopySearchEngines(
+    std::vector<raw_ptr<const PrepopulatedEngine>>& engines) {
+  const PrepopulatedEngine* google_engine = &TemplateURLPrepopulateData::google;
+  const PrepopulatedEngine* duckduckgo =
+      &TemplateURLPrepopulateData::duckduckgo;
+
+  auto find_engine = [&](const PrepopulatedEngine* engine) {
+    return std::find_if(
+        engines.begin(), engines.end(),
+        [engine](const raw_ptr<const PrepopulatedEngine>& candidate) {
+          return candidate.get() == engine;
+        });
+  };
+
+  if (find_engine(google_engine) == engines.end()) {
+    engines.push_back(google_engine);
+  }
+
+  auto duckduckgo_it = find_engine(duckduckgo);
+  if (duckduckgo_it == engines.end()) {
+    engines.insert(engines.begin(), duckduckgo);
+    return;
+  }
+  if (duckduckgo_it == engines.begin()) {
+    return;
+  }
+  raw_ptr<const PrepopulatedEngine> found = *duckduckgo_it;
+  engines.erase(duckduckgo_it);
+  engines.insert(engines.begin(), found);
+}
+
 }  // namespace
 
