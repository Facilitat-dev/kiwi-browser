+    /** Unpack the uBlock Origin zip from APK assets into app_ublock/ once. */
+    private static void installBundledUblock(Context context) {
+        File dest = context.getDir("ublock", Context.MODE_PRIVATE);
+        File marker = new File(dest, "uBlock0.chromium/manifest.json");
+        if (marker.isFile()) {
+            return;
+        }
+        try (InputStream in = context.getAssets().open("ublock.zip");
+                ZipInputStream zip = new ZipInputStream(in)) {
+            ZipEntry entry;
+            byte[] buf = new byte[16384];
+            while ((entry = zip.getNextEntry()) != null) {
+                String name = entry.getName();
+                if (name.contains("..")) {
+                    continue;
+                }
+                File out = new File(dest, name);
+                if (entry.isDirectory()) {
+                    if (!out.exists() && !out.mkdirs()) {
+                        Log.w("Canopy", "ublock mkdir failed: " + out);
+                    }
+                    continue;
+                }
+                File parent = out.getParentFile();
+                if (parent != null && !parent.exists() && !parent.mkdirs()) {
+                    Log.w("Canopy", "ublock parent mkdir failed: " + parent);
+                    continue;
+                }
+                try (FileOutputStream fos = new FileOutputStream(out)) {
+                    int n;
+                    while ((n = zip.read(buf)) > 0) {
+                        fos.write(buf, 0, n);
+                    }
+                }
+            }
+        } catch (Exception e) {
+            Log.w("Canopy", "Failed to unpack bundled uBlock Origin", e);
+        }
+    }
+
