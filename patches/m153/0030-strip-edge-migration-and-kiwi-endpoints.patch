+    /**
+     * Kiwi / find.kiwi hosts and the Microsoft Edge add-ons store.
+     *
+     * <p>Relixor {@code PersonalizeResults} injects a script on
+     * microsoftedge.microsoft.com/addons, and the overlay fetches
+     * popular.kiwibrowser.com, settings.kiwibrowser.com, and find.kiwi. Those
+     * files are not in Chromium 153. This check is the stock counterpart: do not
+     * treat those hosts like the Chrome Web Store.
+     */
+    public static boolean isStrippedProductEndpoint(@Nullable GURL url) {
+        if (url == null || url.isEmpty()) {
+            return false;
+        }
+        String host = url.getHost();
+        return hostMatches(host, "kiwibrowser.com")
+                || hostMatches(host, "find.kiwi")
+                || hostMatches(host, "kiwibrowser.org")
+                || hostMatches(host, "kiwisearchservices.com")
+                || hostMatches(host, "kiwisearchservices.net")
+                || hostMatches(host, "microsoftedge.microsoft.com")
+                || hostMatches(host, "edge.microsoft.com");
+    }
+
+    private static boolean hostMatches(String host, String domain) {
+        if (host == null || domain == null) {
+            return false;
+        }
+        return host.equals(domain) || host.endsWith("." + domain);
+    }
